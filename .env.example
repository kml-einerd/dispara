# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Redis
REDIS_URL="redis://localhost:6379"

# Supabase Auth (backend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Supabase Auth (frontend — NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id-here"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret-here"

# GitHub
GITHUB_TOKEN="your-github-token-here"
GITHUB_USER="your-github-user"
GITHUB_REPO="your-org/your-repo"

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
CLOUDFLARE_TOKEN="your-token-here"
R2_ACCOUNT_ID="your-account-id-here"
R2_TOKEN="your-token-here"
R2_BUCKET="your-bucket-name"

# Mercado Livre OAuth
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3001/v1/oauth/mercadolivre/callback"

# Frontend URL (for OAuth callback redirects)
FRONTEND_URL="http://localhost:5173"

# WhatsApp
WA_SESSION_DIR="/data/wa-sessions"
WA_ENCRYPTION_KEY="your-32-char-secret-key-here"

# Server
API_PORT=3001
API_HOST="0.0.0.0"

# Environment
NODE_ENV="development"

# AI (OpenRouter)
OPENROUTER_API_KEY="your-openrouter-key-here"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
