# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?schema=public"

# Redis
REDIS_URL="redis://localhost:6390"

# Supabase Auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# WhatsApp
WA_SESSION_DIR="/data/wa-sessions"
WA_ENCRYPTION_KEY="your-32-char-secret-key-here"

# Server
API_PORT=3001
API_HOST="0.0.0.0"

# Mercado Livre OAuth
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3001/v1/oauth/mercadolivre/callback"

# Frontend URL (for OAuth callback redirects)
FRONTEND_URL="http://localhost:5173"

# Telegram Monitoring
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Environment
NODE_ENV="development"

# AI
ANTHROPIC_API_KEY="your-anthropic-key-here"
GEMINI_API_KEY="your-gemini-key-here"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your-account-id-here"
R2_ACCESS_TOKEN="your-token-here"
R2_BUCKET="your-bucket-name"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"
